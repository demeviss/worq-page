.services-sticky {
  position: sticky;
  top: 120px;
  height: fit-content;
  align-self: flex-start;
}

/* QUITA sticky de aquí */
.services-text {
  position: relative;
}

.services-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  padding: 6rem 8%;
  background: #ffffff;
  color: #000000;
}

/* TEXTO IZQUIERDO */
.services-text {
  position: sticky;
  top: 120px; /* 👈 debajo del header */
  align-self: start;
}

.services-text h2 {
  font-size: 3rem;
  margin-bottom: 1.5rem;
  color: #000;
}

.services-text p {
  color: #333;
  line-height: 1.6;
  margin-bottom: 1.2rem;
}

.services-cta {
  display: inline-block;
  margin-top: 2rem;
  color: #ff7a00;
  text-decoration: none;
  border-bottom: 1px solid #ff7a00;
}
@media (max-width: 768px) {
  .services-section {
    grid-template-columns: 1fr;
  }

  .services-text {
    position: relative;
    top: auto;
    margin-bottom: 3rem;
  }
}


/* LISTA DERECHA */

.services-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* ITEM */
.service-item:hover img {
  transform: scale(1.08);
  opacity: 1;
}

/* ITEM BASE */
.service-item {
  position: relative;
  display: grid;
  grid-template-columns: 72px 1fr auto;
  align-items: center;
  gap: 32px;
  padding: 28px 0;

  border-bottom: 1px solid rgba(0,0,0,0.1);
  text-decoration: none;
  color: #000;

  transition: opacity 0.3s ease;
}

.service-item:hover {
  opacity: 0.75;
}

 
.service-item:hover span {
  transform: translateX(4px);
}

.service-item {
  .service-item {
  display: grid;
  grid-template-columns: 72px 1.5fr auto; /* icono | texto | botón */
  align-items: center;
  gap: 32px; /* 👈 AQUÍ está la elegancia */
  padding: 28px 0;
}
  position: relative;
  transition: all 0.3s ease;
}
.service-item span {
  font-size: 15px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 400;
}


.service-item::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 1px;
  background: #ff7a00;
  transition: width 0.4s ease;
}

.service-item:hover::after {
  width: 100%;
}



/* ICONOS */

.service-icon {
  width: 32px;
  height: 32px;
  border: 1px solid #ff7a00;
  display: flex;
  align-items: center;
  justify-content: center;
}


/* Si tus iconos son SVG o PNG */
.service-item img {
  width: 64px;
  height: auto;
  display: block;
  opacity: 0.85;

  transition: transform 0.4s ease, opacity 0.4s ease;
}

.service-item:hover img {
  transform: scale(1.06);
  opacity: 1;
}


.service-icon img {
  width: 100%;
  height: auto;
}

/* BOTÓN */

.service-item button {
  background: none;
  border: none;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ff7a00;

  opacity: 0;
  transform: translateX(-6px);
  transition: all 0.4s ease;
  cursor: pointer;
}

.service-item:hover button {
  opacity: 1;
  transform: translateX(0);
}
@media (max-width: 768px) {
  .service-item {
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding: 22px 0;
  }

 .service-item button {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff7a00;

    border: none;
    background: none;
    padding: 0;
    margin-top: 4px;
  }

  .service-item img {
    width: 52px;
  }
}

/* ===== TABLET ===== */
@media (max-width: 1024px) {
  .services-section {
    gap: 3rem;
    padding: 5rem 6%;
  }

  .services-text h2 {
    font-size: 2.5rem;
  }

  .service-item {
    grid-template-columns: 40px 1fr auto;
  }
}

/* ===== MOBILE ===== */
@media (max-width: 768px) {

  /* Cambia a una sola columna */
  .services-section {
    grid-template-columns: 1fr;
    padding: 4rem 6%;
  }

  /* Texto primero */
  .services-text {
    margin-bottom: 3rem;
  }

  .services-text h2 {
    font-size: 2.2rem;
  }

  .services-text p {
    font-size: 0.95rem;
  }

  /* Servicios en columna */
  .services-list {
    gap: 0.8rem;
  }

  .service-item {
    grid-template-columns: 36px 1fr auto;
    padding: 0.8rem 0;
  }

  .service-item span {
    font-size: 0.95rem;
  }

  .service-item button {
    padding: 0.35rem 0.7rem;
    font-size: 0.75rem;
  }
}

/* ===== MOBILE PEQUEÑO ===== */
@media (max-width: 480px) {

  .services-section {
    padding: 3rem 5%;
  }

  .services-text h2 {
    font-size: 1.9rem;
  }

  .services-text p {
    font-size: 0.9rem;
  }

  /* Botón CTA */
  .services-cta {
    font-size: 0.8rem;
  }

  /* Servicio más compacto */
  .service-item {
    grid-template-columns: 32px 1fr;
    gap: 0.8rem;
  }

  .service-item button {
    display: none; /* estilo editorial limpio */
  }
}





/* ===== PARTNERS ===== */
.partner-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160px; /* da aire entre logos */
}

.partners-section {
  padding: 120px 8% 100px;
  background: #fff;
}

.partners-content {
  max-width: 520px;
  margin-bottom: 60px;
}

.partners-content h2 {
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 400;
  margin-bottom: 20px;
}

.partners-content p {
  font-size: 32px;
  line-height: 1.6;
  color: #555;
}

/* slider */
.partners-slider {
  overflow: hidden;
  width: 100%;
}

.partners-track {
  display: flex;
  gap: 80px;
  width: max-content;
  animation: partners-scroll 35s linear infinite;
  align-items: center;
   opacity: 0.9;

}

.partners-track img {
  max-height: 70px;
  max-width: 140px;
  width: auto;
  height: auto;

  object-fit: contain;

  opacity: 0.6;
  filter: grayscale(100%);
  transition: opacity 0.4s ease, filter 0.4s ease, transform 0.4s ease;
}

.partners-slider::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  width: 80px;
  height: 100%;
  background: linear-gradient(to right, transparent, #fff);
  pointer-events: none;
}
.partners-track img:hover {
  opacity: 1;
  filter: grayscale(0);
}

/* animación */
@keyframes partners-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

/* mobile */
@media (max-width: 768px) {
  .partners-section {
    padding: 80px 6%;
  }

  .partners-track img {
    height: 150px;   /* 👈 AQUÍ */
  }


  .partner-link {
    min-width: 160px; /* 👈 más presencia */
  }

  .partners-track img {
    max-height: 95px;  /* 👈 MÁS GRANDE */
    max-width: 130px;
  }
}
@media (max-width: 480px) {
  .partners-track {
    gap: 36px;
  }

  .partner-link {
    min-width: 140px;
  }

  .partners-track img {
    max-height: 52px;
    max-width: 120px;
  }
}
